package renvo:emulator@0.1.0;

interface api {
    enum logic {
        zero,
        one,
        high-z,
        unknown,
    }

    record pin-stimulus {
        at: u64,
        pin: u8,
        value: logic,
    }

    record run-options {
        max-instructions: u64,
        deadline-ticks: option<u64>,
        stimuli: list<pin-stimulus>,
    }

    enum radio-protocol {
        wifi,
        bluetooth-le,
        ieee802154,
    }

    record radio-frame {
        at: u64,
        protocol: radio-protocol,
        center-khz: u32,
        bandwidth-khz: u32,
        phy: string,
        bytes: list<u8>,
        power-dbm: s16,
    }

    record radio-run-options {
        run: run-options,
        radio-frames: list<radio-frame>,
    }

    list-targets: func() -> result<string, string>;
    inspect-elf: func(firmware: list<u8>) -> result<string, string>;
    run-elf: func(target: string, firmware: list<u8>, options: run-options) -> result<string, string>;
    run-radio-elf: func(target: string, firmware: list<u8>, boot-rom: list<u8>, options: radio-run-options) -> result<string, string>;
    run-intel-hex: func(target: string, firmware: list<u8>, options: run-options) -> result<string, string>;
}

world renvo {
    export api;
}
