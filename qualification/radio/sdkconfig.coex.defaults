# Reproducible public-API Wi-Fi/BLE coexistence qualification.
CONFIG_APP_REPRODUCIBLE_BUILD=y
# CONFIG_APP_COMPILE_TIME_DATE is not set
# CONFIG_BOOTLOADER_COMPILE_TIME_DATE is not set

CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_NIMBLE_50_FEATURE_SUPPORT=n

# The combined public Wi-Fi and NimBLE application exceeds the 1 MiB default.
CONFIG_PARTITION_TABLE_SINGLE_APP_LARGE=y
