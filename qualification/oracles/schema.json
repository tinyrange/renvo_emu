{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/tinyrange/renvo_emu/blob/main/qualification/oracles/schema.json",
  "title": "Renvo Emulator oracle fixture",
  "type": "object",
  "required": [
    "schema",
    "fixture_id",
    "status",
    "target",
    "hardware",
    "firmware",
    "initial_state",
    "stimulus",
    "observations",
    "comparison",
    "provenance"
  ],
  "properties": {
    "schema": { "const": "remu.oracle.v1" },
    "fixture_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]+$"
    },
    "status": {
      "enum": ["hardware_capture", "external_emulator", "remu_reference"]
    },
    "target": {
      "type": "object",
      "required": ["architecture", "machine", "board"],
      "properties": {
        "architecture": { "type": "string", "minLength": 1 },
        "machine": { "type": "string", "minLength": 1 },
        "board": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": true
    },
    "hardware": {
      "type": "object",
      "required": ["board", "mcu", "revision", "probe", "toolchain"],
      "properties": {
        "board": { "type": "string", "minLength": 1 },
        "mcu": { "type": "string", "minLength": 1 },
        "revision": { "type": "string", "minLength": 1 },
        "probe": { "type": "object" },
        "toolchain": { "type": "object" }
      },
      "additionalProperties": true
    },
    "firmware": {
      "type": "object",
      "required": ["source_files", "source_sha256", "image_sha256", "build"],
      "properties": {
        "source_files": { "type": "array", "minItems": 1 },
        "source_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "image_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "build": { "type": "object" }
      },
      "additionalProperties": true
    },
    "initial_state": { "type": "object" },
    "stimulus": {
      "type": "object",
      "required": ["kind", "steps"],
      "properties": {
        "kind": { "type": "string", "minLength": 1 },
        "steps": { "type": "array", "minItems": 1 }
      },
      "additionalProperties": true
    },
    "observations": {
      "type": "object",
      "required": ["format", "records", "canonical_sha256"],
      "properties": {
        "format": { "type": "string", "minLength": 1 },
        "records": { "type": "array", "minItems": 1 },
        "canonical_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "additionalProperties": true
    },
    "comparison": {
      "type": "object",
      "required": ["reference", "expected_observations", "equivalence", "timing"],
      "properties": {
        "reference": { "type": "string", "minLength": 1 },
        "expected_observations": { "type": "integer", "minimum": 1 },
        "equivalence": { "type": "string", "minLength": 1 },
        "timing": { "type": "object" }
      },
      "additionalProperties": true
    },
    "provenance": {
      "type": "object",
      "required": ["captured_at", "capture_method", "capture_source_sha256"],
      "properties": {
        "captured_at": { "type": "string", "minLength": 1 },
        "capture_method": { "type": "string", "minLength": 1 },
        "capture_source_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": false
}
