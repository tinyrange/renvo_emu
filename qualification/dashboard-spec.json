        "firmware_functional_slice": ["qualification/register-coverage/ch32v006.json", "qualification/native-images.json", "qualification/stop-conditions.json"],
        "selected_board_or_sdk_workflow": ["qualification/vendor-samples.json"]
      },
      "passing_corpus": [
        "Docker GCC, Clang and Rust compiler cases",
