        "CoreMark standard performance and validation workloads",
        "Unmodified WCH EVT GPIO Toggle"
      ]
    },
    "rp2040": {
      "highest_tier": "selected_board_or_sdk_workflow",
      "native_image_formats": ["elf", "uf2"],
      "peripheral_scope": ["SIO GPIO", "UART0", "TIMER", "PIO0", "USB", "XIP", "VCD"],
      "official_workflows": ["Unmodified Pico SDK blink_simple"],
      "peripheral_tracker": "https://github.com/tinyrange/renvo_emu/issues/6",
      "tier_artifacts": {
        "compiler_execution": ["qualification/arm-cpu.json", "qualification/rust-abi.json"],
        "firmware_functional_slice": ["qualification/register-coverage/rp2040.json", "qualification/native-images.json", "qualification/stop-conditions.json"],
