{
  "schema": "remu.dashboard-spec.v2",
  "tier_definitions": [
    {
      "id": "compiler_execution",
      "label": "Compiler execution",
      "description": "Compiler-produced code runs through a documented CPU and ABI subset with bounded results and tracing."
    },
    {
      "id": "firmware_functional_slice",
      "label": "Firmware functional slice",
      "description": "Native image handling and a tested subset of chip-specific GPIO, timer, UART, interrupt, and startup behavior."
    },
    {
      "id": "selected_board_or_sdk_workflow",
      "label": "Selected board or SDK workflow",
      "description": "A named board, SDK path, vendor sample, or official firmware image reaches a tested endpoint; this never implies arbitrary firmware compatibility."
    }
  ],
  "targets": {
    "ch32v003": {
      "highest_tier": "selected_board_or_sdk_workflow",
      "native_image_formats": ["elf", "raw-bin"],
      "peripheral_scope": ["GPIO", "TIM2", "USART1", "PFIC", "RCC", "VCD"],
      "official_workflows": ["Unmodified WCH EVT GPIO Toggle"],
      "peripheral_tracker": "https://github.com/tinyrange/renvo_emu/issues/4",
      "tier_artifacts": {
        "compiler_execution": ["qualification/riscv-cpu.json", "qualification/rust-abi.json"],
        "firmware_functional_slice": ["qualification/register-coverage/ch32v003.json", "qualification/native-images.json", "qualification/stop-conditions.json"],
        "selected_board_or_sdk_workflow": ["qualification/vendor-samples.json"]
      },
      "passing_corpus": [
        "Docker GCC, Clang and Rust compiler cases",
        "1,000-case generated C corpus",
        "CoreMark 1,200-byte profile workload",
        "Unmodified WCH EVT GPIO Toggle"
      ]
    },
    "ch32v006": {
      "highest_tier": "selected_board_or_sdk_workflow",
      "native_image_formats": ["elf", "raw-bin"],
      "peripheral_scope": ["GPIO", "TIM2", "USART1", "PFIC", "RCC", "VCD"],
      "official_workflows": ["Unmodified WCH EVT GPIO Toggle"],
